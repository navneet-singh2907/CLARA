FROM node:22-bookworm-slim AS web-deps

WORKDIR /build/web

COPY web/package.json web/package-lock.json ./
RUN npm ci

FROM node:22-bookworm-slim AS web-builder

WORKDIR /build/web

ARG NEXT_PUBLIC_API_BASE_URL=__SAME_ORIGIN__
ARG CLARA_INTERNAL_API_URL=http://127.0.0.1:8001
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL} \
    CLARA_INTERNAL_API_URL=${CLARA_INTERNAL_API_URL}

COPY --from=web-deps /build/web/node_modules ./node_modules
COPY web/ ./
RUN npm run build

FROM python:3.12-slim-bookworm AS python-deps

ENV PIP_NO_CACHE_DIR=1

COPY requirements.txt /tmp/requirements.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install -r /tmp/requirements.txt

FROM python-deps AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=8000

WORKDIR /app

COPY --from=web-deps /usr/local/bin/node /usr/local/bin/node
RUN node --version
COPY api ./api
COPY loan_pipeline ./loan_pipeline
COPY sample_documents ./sample_documents
COPY pyproject.toml README.md ./
COPY scripts/start_aws_fullstack.py ./scripts/start_aws_fullstack.py
COPY --from=web-builder /build/web/.next/standalone ./web
COPY --from=web-builder /build/web/.next/static ./web/.next/static

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/health', timeout=3)"]

CMD ["python", "scripts/start_aws_fullstack.py"]
